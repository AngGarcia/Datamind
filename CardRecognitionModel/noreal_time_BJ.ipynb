import cv2
import os
from pathlib import Path
from ultralytics import YOLO

"""## 1. Configuracion"""

YOLO_PATH = r"C:\CV_PROJECTS\card_detection\models\best.pt"

IMAGE_FOLDER = r"C:\CV_PROJECTS\card_detection\test_images"

OUTPUT_VISUALS = r"C:\CV_PROJECTS\card_detection\output_visuals"

CONF_THRES = 0.60

os.makedirs(OUTPUT_VISUALS, exist_ok=True)

"""## 2. Load model"""

model = YOLO(YOLO_PATH)

# SIDE DETECTION

def get_side(cx, cy, h):
    return "dealer" if cy < h // 2 else "player"

"""## 3. Process Image"""

def process_image(image_path):

    frame = cv2.imread(image_path)

    if frame is None:
        return None

    h, w = frame.shape[:2]

    # DRAW DEALER / PLAYER SPLIT

    cv2.line(frame, (0, h//2), (w, h//2), (255,0,0), 2)

    cv2.putText(
        frame,
        "DEALER",
        (20, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (255,0,0),
        2
    )

    cv2.putText(
        frame,
        "PLAYER",
        (20, h//2 + 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (0,255,0),
        2
    )

    # YOLO INFERENCE

    results = model.predict(
        frame,
        conf=CONF_THRES,
        verbose=False
    )

    dealer = []
    player = []

    boxes = results[0].boxes

    if boxes is not None:

        for box in boxes:

            conf = float(box.conf[0])

            if conf < CONF_THRES:
                continue

            cls_id = int(box.cls[0])

            # nombre clase YOLO
            label = model.names[cls_id]

             # EXTRAER SOLO EL RANK

            rank = label.split("_")[0]

            x1, y1, x2, y2 = map(int, box.xyxy[0])

            cx = (x1 + x2) // 2
            cy = (y1 + y2) // 2

            side = get_side(cx, cy, h)

            # SAVE RESULT
            if side == "dealer":
                dealer.append(rank)
                color = (255,0,0)

            else:
                player.append(rank)
                color = (0,255,0)
            # DRAW
            cv2.rectangle(
                frame,
                (x1, y1),
                (x2, y2),
                color,
                3
            )

            text = f"{rank} {conf:.2f}"

            cv2.putText(
                frame,
                text,
                (x1, y1 - 10),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                color,
                2
            )

    # SORT LEFT TO RIGHT

    dealer = sorted(dealer)
    player = sorted(player)

    # SAVE IMAGE

    out_path = os.path.join(
        OUTPUT_VISUALS,
        Path(image_path).name
    )

    cv2.imwrite(out_path, frame)

    return {
        "image": Path(image_path).name,
        "dealer": dealer,
        "player": player
    }

"""## 4. Run all Images"""

results_all = []

image_files = sorted([
    str(p)
    for p in Path(IMAGE_FOLDER).glob("*.*")
    if p.suffix.lower() in [".jpg", ".jpeg", ".png"]
])

for img_path in image_files:

    result = process_image(img_path)

    if result:
        results_all.append(result)

# =====================================================
# FINAL RESULTS
# =====================================================

for r in results_all:

    print("\n===================================")
    print("IMAGE:", r["image"])
    print("DEALER:", r["dealer"])
    print("PLAYER:", r["player"])

print("\nDONE")
print("Processed:", len(results_all))

print("Processed:", len(results_all))

